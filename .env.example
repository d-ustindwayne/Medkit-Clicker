# Server and setup-script settings. Copy to .env (gitignored) and fill in.
# Aiven: Services > your PostgreSQL > Overview > Service URI (keep ?sslmode=require).
DATABASE_URL=postgres://avnadmin:PASSWORD@HOST.aivencloud.com:PORT/defaultdb?sslmode=require
# Any long random string; it signs the unlock tokens.
SERVER_SECRET=change-me-to-a-long-random-string
# Optional: the ntfy.sh topic Dustin subscribes to for redemption alerts (keep it hard to guess).
NTFY_TOPIC=
PORT=8787

# App side (goes in .env.local, read at build time): where the server lives.
# EXPO_PUBLIC_API_URL=https://your-server.example.com
