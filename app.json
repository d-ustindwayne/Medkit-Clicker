{
  "expo": {
    "name": "Medkit Clicker",
    "slug": "mc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mc",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#fafdf3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dust.dev.mc"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/with-abi-filters",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f9e8e8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#1d2e33",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-audio",
      "expo-sharing",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-asset",
      [
        "expo-media-library",
        {
          "photosPermission": "Medkit Clicker saves stickers to your photos.",
          "savePhotosPermission": "Medkit Clicker saves stickers to your photos.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "87dece06-184a-4ef8-b7cb-6298b688b3a7"
      }
    },
    "owner": "dustdevs-team"
  }
}
