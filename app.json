{
  "expo": {
    "name": "Medkit Clicker",
    "slug": "mc",
    "version": "0.9.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mc",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.medkitclicker.app",
      "buildNumber": "0.5.0"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#fafdf3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.medkitclicker.app",
      "versionCode": 10
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/with-abi-filters",
      "./plugins/with-release-signing",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f9e8e8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#1d2e33",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-audio",
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": false,
          "androidForegroundService": false,
          "androidPermissions": [],
          "disableFFmpeg": true
        }
      ],
      "expo-sharing",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-asset",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Progress",
              "label": "Medkit Clicker",
              "description": "Your medkits and how fast they're coming in.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Medkit Clicker uses a photo you pick as your background.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Medkit Clicker saves stickers to your photos.",
          "savePhotosPermission": "Medkit Clicker saves stickers to your photos.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Gold",
            "ios": "./assets/images/icons/gold.png",
            "android": {
              "foregroundImage": "./assets/images/icons/gold-foreground.png",
              "backgroundColor": "#fff6d6"
            }
          },
          {
            "name": "Candy",
            "ios": "./assets/images/icons/candy.png",
            "android": {
              "foregroundImage": "./assets/images/icons/candy-foreground.png",
              "backgroundColor": "#fff0f5"
            }
          },
          {
            "name": "Night",
            "ios": "./assets/images/icons/night.png",
            "android": {
              "foregroundImage": "./assets/images/icons/night-foreground.png",
              "backgroundColor": "#1c2456"
            }
          },
          {
            "name": "Crystal",
            "ios": "./assets/images/icons/crystal.png",
            "android": {
              "foregroundImage": "./assets/images/icons/crystal-foreground.png",
              "backgroundColor": "#e0f6ff"
            }
          },
          {
            "name": "Dustin",
            "ios": "./assets/images/icons/dustin.png",
            "android": {
              "foregroundImage": "./assets/images/icons/dustin-foreground.png",
              "backgroundColor": "#ffe4ec"
            }
          }
        ]
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "87dece06-184a-4ef8-b7cb-6298b688b3a7"
      }
    },
    "owner": "dustdevs-team"
  }
}
