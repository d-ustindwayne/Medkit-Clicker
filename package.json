{
  "name": "medkit-clicker",
  "main": "expo-router/entry",
  "version": "0.7.5",
  "dependencies": {
    "@expo/ui": "~57.0.26",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.31",
    "expo-alternate-app-icons": "^8.0.0",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-media-library": "~57.0.5",
    "expo-router": "~57.0.29",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "nativewind": "^4.2.6",
    "postcss": "^8.5.26",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-audio-api": "0.13.6",
    "react-native-css-interop": "^0.2.6",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.7",
    "beepbox": "4.2.0",
    "eslint": "^9",
    "eslint-config-expo": "~57",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "music:compose": "bun scripts/compose-music.ts",
    "sfx:compose": "bun scripts/compose-sfx.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "server": "bun server/index.ts",
    "db:setup": "bun --preload ./scripts/test-preload.ts scripts/db-setup.ts",
    "apk:phone": "cd android && ./gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a -Pandroid.enableMinifyInReleaseBuilds=true -Pandroid.enableShrinkResourcesInReleaseBuilds=true",
    "apk:release": "cd android && ./gradlew assembleRelease -PmcRelease=true -PreactNativeArchitectures=armeabi-v7a,arm64-v8a -Pandroid.enableMinifyInReleaseBuilds=true -Pandroid.enableShrinkResourcesInReleaseBuilds=true",
    "add-code": "bun scripts/add-code.ts",
    "add-promo": "bun scripts/add-promo.ts",
    "expire-section": "bun scripts/expire-section.ts"
  },
  "private": true,
  "license": "Apache-2.0",
  "author": "Dustin Dwayne Diaz",
  "patchedDependencies": {
    "expo-alternate-app-icons@8.0.0": "patches/expo-alternate-app-icons@8.0.0.patch"
  },
  "reanimated": {
    "staticFeatureFlags": {
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true,
      "IOS_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  }
}
